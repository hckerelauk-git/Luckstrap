<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.GameShortcutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="GameShortcutPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Shortcut_Title}" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,4,0,16"
                   Text="{x:Static resources:Strings.Shortcut_Help}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="{x:Static resources:Strings.Nav_Games}" FontSize="14" FontWeight="Medium" Margin="0,0,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="PlaceIdBox"
                        PlaceholderText="{x:Static resources:Strings.Common_PlaceIdPlaceholder}" />

            <ComboBox x:Name="PickBox"
                      Grid.Column="1"
                      Width="260"
                      Margin="8,0,0,0"
                      Padding="10,6"
                      DisplayMemberPath="DisplayText"
                      ToolTip="{x:Static resources:Strings.Shortcut_PickHint}"
                      SelectionChanged="OnPickSelected" />
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="{x:Static resources:Strings.Shortcut_JobId}" FontSize="14" FontWeight="Medium" Margin="0,0,0,6" />
                <ui:TextBox x:Name="JobIdBox" PlaceholderText="{x:Static resources:Strings.Shortcut_JobIdHint}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="{x:Static resources:Strings.Shortcut_AccessCode}" FontSize="14" FontWeight="Medium" Margin="0,0,0,6" />
                <ui:TextBox x:Name="AccessCodeBox" PlaceholderText="{x:Static resources:Strings.Shortcut_AccessCodeHint}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{x:Static resources:Strings.Shortcut_Where}" FontSize="14" FontWeight="Medium" Margin="0,16,0,6" />
        <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="DesktopCheck" Content="{x:Static resources:Strings.Shortcut_Desktop}" IsChecked="True" VerticalAlignment="Center" />
            <CheckBox x:Name="StartMenuCheck" Content="{x:Static resources:Strings.Shortcut_StartMenu}" IsChecked="True" Margin="20,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{x:Static resources:Strings.Shortcut_Name}" FontSize="14" FontWeight="Medium" Margin="0,16,0,6" />
        <ui:TextBox x:Name="NameBox" PlaceholderText="{x:Static resources:Strings.Shortcut_NameHint}" />

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <ui:Button x:Name="CreateAndLaunchButton"
                       Content="{x:Static resources:Strings.Shortcut_CreateAndLaunch}"
                       Icon="Play24"
                       Appearance="Primary"
                       Click="OnCreateAndLaunch" />
            <ui:Button Content="{x:Static resources:Strings.Shortcut_CreateOnly}"
                       Icon="Add24"
                       Margin="8,0,0,0"
                       Click="OnCreateOnly" />
            <ui:Button Content="{x:Static resources:Strings.Shortcut_Delete}"
                       Icon="Delete24"
                       Margin="8,0,0,0"
                       Click="OnDelete" />
        </StackPanel>

        <ui:InfoBar x:Name="StatusBar"
                    Severity="Informational"
                    IsOpen="False"
                    IsClosable="True"
                    Margin="0,16,0,0" />

        <Separator Margin="0,24,0,16" />

        <TextBlock Text="{x:Static resources:Strings.Common_Note}" FontSize="16" FontWeight="Medium" />
        <TextBlock Margin="0,8,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static resources:Strings.Shortcut_NoteBody}" />
    </StackPanel>
</ui:UiPage>
