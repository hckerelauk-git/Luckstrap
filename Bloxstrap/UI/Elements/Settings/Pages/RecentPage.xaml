<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.RecentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="RecentPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Recent_Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{x:Static resources:Strings.Recent_Help}" Style="{StaticResource PageDescription}" />

        <ui:InfoBar x:Name="StatusBar" Severity="Informational" IsOpen="False" IsClosable="True" Margin="0,0,0,12" />

        <TextBlock x:Name="EmptyText"
                   Margin="0,60,0,0"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{x:Static resources:Strings.Recent_Empty}" />

        <ItemsControl x:Name="HistoryList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource GameCard}">
                        <StackPanel>
                            <Border Height="110" CornerRadius="8,8,0,0" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding ThumbnailUrl, IsAsync=True}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <StackPanel Margin="10,8,10,10">
                                <TextBlock Text="{Binding GameName}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding GameName}" />

                                <TextBlock Text="{Binding Subtitle}"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <TextBlock Text="{Binding Detail}"
                                           Margin="0,1,0,0"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Detail}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                <ui:Button Margin="0,8,0,0"
                                           HorizontalAlignment="Stretch"
                                           Content="{x:Static resources:Strings.Recent_Rejoin}"
                                           Icon="Play16"
                                           Appearance="Primary"
                                           Padding="10,4"
                                           FontSize="12"
                                           Command="{Binding RejoinCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <WrapPanel Margin="0,4,0,0">
            <ui:Button Icon="ArrowClockwise24" Content="{x:Static resources:Strings.Common_Refresh}" Click="OnRefresh" Margin="0,0,8,0" />
            <ui:Button Icon="Delete24" Content="{x:Static resources:Strings.Recent_Clear}" Appearance="Danger" Click="OnClear" />
        </WrapPanel>

        <TextBlock Margin="0,24,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{x:Static resources:Strings.Recent_Privacy}" />
    </StackPanel>
</ui:UiPage>
