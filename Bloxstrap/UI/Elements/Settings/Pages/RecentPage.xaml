<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.RecentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="RecentPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="最近玩过" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,4,0,16"
                   Text="进过的服务器都记在这里，最多留 50 条，重启也在。装 Luckstrap 之前的记录是从 Roblox 自己的日志里翻出来的，只要日志还在就能补上。点「再进这个服」会回到同一台服务器 —— 前提是它还没关。"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ui:InfoBar x:Name="StatusBar" Severity="Informational" IsOpen="False" IsClosable="True" Margin="0,0,0,12" />

        <TextBlock x:Name="EmptyText"
                   Margin="0,40,0,0"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="还没有记录。进一次游戏，退出来就有了。" />

        <ItemsControl x:Name="HistoryList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="72" Height="72" CornerRadius="5" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding ThumbnailUrl, IsAsync=True}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ui:Button Grid.Column="2"
                                       Content="再进这个服"
                                       Icon="Play16"
                                       Appearance="Primary"
                                       Padding="12,3"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Command="{Binding RejoinCommand}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <WrapPanel Margin="0,12,0,0">
            <ui:Button Icon="ArrowClockwise24" Content="刷新" Click="OnRefresh" Margin="0,0,8,0" />
            <ui:Button Icon="Delete24" Content="清空记录" Appearance="Danger" Click="OnClear" />
        </WrapPanel>

        <Separator Margin="0,20,0,14" />

        <TextBlock Text="说明" FontSize="16" FontWeight="Medium" />
        <TextBlock Margin="0,8,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="记录来自游戏日志，只存重连要用的东西，不存聊天记录也不存你在里面干了什么。私服的访问码会一起存下来，不然重连进不去。清空只删这份记录，不影响游戏本身。" />
    </StackPanel>
</ui:UiPage>
