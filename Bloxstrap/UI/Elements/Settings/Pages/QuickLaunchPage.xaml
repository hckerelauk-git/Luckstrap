<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.QuickLaunchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="QuickLaunchPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Hub_Games_QuickLaunch}" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,4,0,16"
                   Text="{x:Static resources:Strings.QuickLaunch_Help}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="{x:Static resources:Strings.Common_PickFromRecent}" FontSize="14" FontWeight="Medium" Margin="0,0,0,6" />
        <ComboBox x:Name="RecentBox"
                  Margin="0,0,0,14"
                  DisplayMemberPath="DisplayText"
                  SelectionChanged="OnRecentSelected"
                  ToolTip="{x:Static resources:Strings.QuickLaunch_FromRecentHint}" />

        <TextBlock Text="{x:Static resources:Strings.Nav_Games}" FontSize="14" FontWeight="Medium" Margin="0,0,0,6" />
        <ui:TextBox x:Name="PlaceIdBox"
                    PlaceholderText="{x:Static resources:Strings.Common_PlaceIdPlaceholder}"
                    TextChanged="OnInputChanged" />

        <TextBlock Text="{x:Static resources:Strings.QuickLaunch_AccessCode}" FontSize="14" FontWeight="Medium" Margin="0,14,0,6" />
        <ui:TextBox x:Name="JobIdBox"
                    PlaceholderText="{x:Static resources:Strings.QuickLaunch_AccessCodeHint}"
                    TextChanged="OnInputChanged" />

        <TextBlock Text="{x:Static resources:Strings.QuickLaunch_Link}" FontSize="14" FontWeight="Medium" Margin="0,16,0,6" />
        <ui:TextBox x:Name="ResultBox"
                    IsReadOnly="True"
                    PlaceholderText="{x:Static resources:Strings.QuickLaunch_LinkHint}"
                    TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <ui:Button x:Name="LaunchButton"
                       Content="{x:Static resources:Strings.QuickLaunch_Launch}"
                       Appearance="Primary"
                       Icon="Play24"
                       Click="OnLaunch"
                       IsEnabled="False" />
            <ui:Button Content="{x:Static resources:Strings.QuickLaunch_Copy}"
                       Icon="Copy24"
                       Margin="8,0,0,0"
                       Click="OnCopy" />
            <ui:Button Content="{x:Static resources:Strings.QuickLaunch_OpenBrowser}"
                       Icon="Globe24"
                       Margin="8,0,0,0"
                       Click="OnOpenWeb" />
        </StackPanel>

        <ui:InfoBar x:Name="StatusBar"
                    Severity="Informational"
                    IsOpen="False"
                    IsClosable="True"
                    Margin="0,16,0,0" />

        <Separator Margin="0,24,0,16" />

        <TextBlock Text="{x:Static resources:Strings.Common_Note}" FontSize="16" FontWeight="Medium" />
        <TextBlock Margin="0,8,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static resources:Strings.QuickLaunch_Note}" />
    </StackPanel>
</ui:UiPage>
