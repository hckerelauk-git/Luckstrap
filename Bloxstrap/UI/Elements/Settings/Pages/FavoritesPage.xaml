<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.FavoritesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="FavoritesPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Favorites_Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{x:Static resources:Strings.Favorites_Help}" Style="{StaticResource PageDescription}" />

        <TextBlock Text="{x:Static resources:Strings.Common_PickFromRecent}" FontSize="14" FontWeight="Medium" Margin="0,0,0,6" />
        <ComboBox x:Name="RecentBox"
                  Margin="0,0,0,14"
                  DisplayMemberPath="DisplayText"
                  SelectionChanged="OnRecentSelected"
                  ToolTip="{x:Static resources:Strings.Favorites_RecentHint}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="InputBox"
                        PlaceholderText="{x:Static resources:Strings.Common_PlaceIdPlaceholder}"
                        KeyDown="OnInputKeyDown" />

            <ui:Button x:Name="AddButton"
                       Grid.Column="1"
                       Content="{x:Static resources:Strings.Common_Add}"
                       Icon="Add24"
                       Appearance="Primary"
                       Margin="8,0,0,0"
                       Click="OnAdd" />
        </Grid>

        <ui:InfoBar x:Name="StatusBar"
                    Severity="Informational"
                    IsOpen="False"
                    IsClosable="True"
                    Margin="0,14,0,0" />

        <TextBlock x:Name="EmptyHint"
                   Margin="0,32,0,0"
                   Text="{x:Static resources:Strings.Favorites_Empty}"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <ItemsControl x:Name="FavoritesList" Margin="0,18,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:UniformWrapPanel MinItemWidth="180" ItemSpacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource GameCard}">
                        <StackPanel>
                            <Border Height="110" CornerRadius="8,8,0,0" ClipToBounds="True"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Margin="10,8,10,10">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />

                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding Subtitle}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:Button Grid.Column="0"
                                               Content="{x:Static resources:Strings.Common_Launch}"
                                               Icon="Play16"
                                               Appearance="Primary"
                                               Padding="10,4"
                                               FontSize="12"
                                               Tag="{Binding}"
                                               Click="OnLaunch" />

                                    <ui:Button Grid.Column="1"
                                               Content="{x:Static resources:Strings.Common_Delete}"
                                               Padding="8,4"
                                               FontSize="12"
                                               Margin="6,0,0,0"
                                               Tag="{Binding}"
                                               Click="OnRemove" />
                                </Grid>

                                <ui:Button Margin="0,6,0,0"
                                           Content="{x:Static resources:Strings.Shortcut_AddToShortcut}"
                                           Icon="Add16"
                                           Padding="8,4"
                                           FontSize="12"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center"
                                           Tag="{Binding}"
                                           Click="OnAddShortcut" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>
