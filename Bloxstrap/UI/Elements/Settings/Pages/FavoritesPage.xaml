<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.FavoritesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="FavoritesPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="收藏游戏" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,4,0,16"
                   Text="把常玩的游戏存这里，之后点一下就能进，不用每次翻网页。"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="从最近玩过选" FontSize="14" FontWeight="Medium" Margin="0,0,0,6" />
        <ComboBox x:Name="RecentBox"
                  Margin="0,0,0,14"
                  DisplayMemberPath="DisplayText"
                  SelectionChanged="OnRecentSelected"
                  ToolTip="最近进过的服务器，选中后自动填下面的输入框" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="InputBox"
                        PlaceholderText="Place ID 或 https://www.roblox.com/games/123456789/xxx"
                        KeyDown="OnInputKeyDown" />

            <ui:Button x:Name="AddButton"
                       Grid.Column="1"
                       Content="添加"
                       Icon="Add24"
                       Appearance="Primary"
                       Margin="8,0,0,0"
                       Click="OnAdd" />
        </Grid>

        <ui:InfoBar x:Name="StatusBar"
                    Severity="Informational"
                    IsOpen="False"
                    IsClosable="True"
                    Margin="0,14,0,0" />

        <TextBlock x:Name="EmptyHint"
                   Margin="0,32,0,0"
                   Text="还没有收藏。上面粘个游戏链接或者 Place ID 试试。"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <ItemsControl x:Name="FavoritesList" Margin="0,18,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="320" Height="104"
                            Margin="0,0,12,12"
                            CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border CornerRadius="6,0,0,6" ClipToBounds="True"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                            </Border>

                            <Grid Grid.Column="1" Margin="10,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />

                                <TextBlock Grid.Row="1"
                                           Margin="0,2,0,0"
                                           Text="{Binding Subtitle}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <ui:Button Content="启动"
                                               Icon="Play16"
                                               Appearance="Primary"
                                               Padding="10,3"
                                               FontSize="12"
                                               Tag="{Binding}"
                                               Click="OnLaunch" />
                                    <ui:Button Content="删除"
                                               Padding="10,3"
                                               FontSize="12"
                                               Margin="6,0,0,0"
                                               Tag="{Binding}"
                                               Click="OnRemove" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>
