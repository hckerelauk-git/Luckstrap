<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.RegionSelectorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="RegionSelectorPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Region_Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{x:Static resources:Strings.Region_Help}" Style="{StaticResource PageDescription}" />

        <TextBlock Text="{x:Static resources:Strings.Region_PickGame}" FontSize="14" FontWeight="Medium" Margin="0,0,0,6" />
        <ComboBox x:Name="GameBox"
                  Margin="0,0,0,12"
                  DisplayMemberPath="DisplayText"
                  SelectionChanged="OnGameSelected"
                  ToolTip="{x:Static resources:Strings.Region_PickHint}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="PlaceIdBox"
                        PlaceholderText="{x:Static resources:Strings.Region_Placeholder}" />

            <ComboBox x:Name="RegionBox"
                      Grid.Column="1"
                      Width="210"
                      Margin="8,0,0,0"
                      Padding="10,6"
                      ToolTip="{x:Static resources:Strings.Region_PickRegion}" />

            <ui:Button x:Name="JoinButton"
                       Grid.Column="2"
                       Content="{x:Static resources:Strings.Region_Join}"
                       Icon="Play24"
                       Appearance="Primary"
                       Margin="8,0,0,0"
                       Click="OnJoinRegion" />

            <ui:Button x:Name="ListButton"
                       Grid.Column="3"
                       Content="{x:Static resources:Strings.Region_All}"
                       Icon="ArrowSync24"
                       Margin="8,0,0,0"
                       Click="OnQuery" />
        </Grid>

        <ui:InfoBar x:Name="StatusBar"
                    Severity="Informational"
                    IsOpen="False"
                    IsClosable="True"
                    Margin="0,14,0,0" />

        <TextBlock x:Name="HintText"
                   Margin="0,28,0,0"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{x:Static resources:Strings.Region_Loading}" />

        <ItemsControl x:Name="ServerList" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="12,10"
                            CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Region}" FontSize="14" FontWeight="Medium" />
                                    <TextBlock Text="·" Margin="6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding PlayerCountText}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="·" Margin="6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding PingText}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding JobId}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <ui:Button Grid.Column="1"
                                       Content="{x:Static resources:Strings.Region_JoinBtn}"
                                       Icon="Play16"
                                       Appearance="Primary"
                                       Padding="12,3"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Tag="{Binding}"
                                       Click="OnJoin" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,20,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{x:Static resources:Strings.Region_Note}" />
    </StackPanel>
</ui:UiPage>
