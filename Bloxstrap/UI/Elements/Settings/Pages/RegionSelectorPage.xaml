<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.RegionSelectorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="RegionSelectorPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="区服选择" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,4,0,16"
                   Text="填游戏，选一个想进的地区，点一下直接进那个地区的服。不想按地区挑就点「看全部服务器」，自己从列表里选。"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="PlaceIdBox"
                        PlaceholderText="Place ID 或游戏链接" />

            <ComboBox x:Name="RegionBox"
                      Grid.Column="1"
                      Width="210"
                      Margin="8,0,0,0"
                      Padding="10,6"
                      ToolTip="想进哪个地区的服务器" />

            <ui:Button x:Name="JoinButton"
                       Grid.Column="2"
                       Content="进这个地区的服"
                       Icon="Play24"
                       Appearance="Primary"
                       Margin="8,0,0,0"
                       Click="OnJoinRegion" />

            <ui:Button x:Name="ListButton"
                       Grid.Column="3"
                       Content="看全部服务器"
                       Icon="ArrowSync24"
                       Margin="8,0,0,0"
                       Click="OnQuery" />
        </Grid>

        <ui:InfoBar x:Name="StatusBar"
                    Severity="Informational"
                    IsOpen="False"
                    IsClosable="True"
                    Margin="0,14,0,0" />

        <TextBlock x:Name="HintText"
                   Margin="0,28,0,0"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="正在加载地区列表…" />

        <ItemsControl x:Name="ServerList" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="12,10"
                            CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Region}" FontSize="14" FontWeight="Medium" />
                                    <TextBlock Text="·" Margin="6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding PlayerCountText}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="·" Margin="6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding PingText}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding JobId}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <ui:Button Grid.Column="1"
                                       Content="加入"
                                       Icon="Play16"
                                       Appearance="Primary"
                                       Padding="12,3"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Tag="{Binding}"
                                       Click="OnJoin" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Margin="0,20,0,14" />

        <TextBlock Text="说明" FontSize="16" FontWeight="Medium" />
        <TextBlock Margin="0,8,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="服务器列表来自 Roblox 官方接口，一次拉 100 台。地区不在列表里，要逐个发加入请求换数据中心编号，再对照 RoValra 的机房表，所以按地区找服要等一会儿。找到一台就停，不会把 100 台全查完。查不到地区的会显示「未知」，不影响加入。没登录 Roblox 的话查不出地区 —— 这个功能要读本机登录态。" />
    </StackPanel>
</ui:UiPage>
