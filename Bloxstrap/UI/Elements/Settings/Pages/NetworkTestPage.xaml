<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.NetworkTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="NetworkTestPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Hub_Tools_Network}" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,4,0,16"
                   Text="{x:Static resources:Strings.Network_Help}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <StackPanel Orientation="Horizontal">
            <ui:Button x:Name="RunButton"
                       Content="{x:Static resources:Strings.Network_Start}"
                       Icon="ArrowSync24"
                       Appearance="Primary"
                       Click="OnRun" />
            <ui:Button Content="{x:Static resources:Strings.Network_Copy}"
                       Icon="Copy24"
                       Margin="8,0,0,0"
                       Click="OnCopy" />
        </StackPanel>

        <ui:InfoBar x:Name="StatusBar"
                    Severity="Informational"
                    IsOpen="False"
                    IsClosable="True"
                    Margin="0,14,0,0" />

        <ItemsControl x:Name="ResultList" Margin="0,18,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="12,10"
                            CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Status}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="{Binding Detail}"
                                           FontSize="12"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Margin="0,16,0,14" />

        <TextBlock Text="{x:Static resources:Strings.Network_ExplainTitle}" FontSize="14" FontWeight="Medium" />
        <TextBlock Margin="0,6,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static resources:Strings.Network_Explain}" />
    </StackPanel>
</ui:UiPage>
