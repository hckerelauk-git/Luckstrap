<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.StudioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="StudioPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Hub_Games_Studio}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{x:Static resources:Strings.Studio_Help}" Style="{StaticResource PageDescription}" />

        <Border CornerRadius="8" Padding="16,13,16,12" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="StateText" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="PathText" Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="LaunchButton"
                               Content="{x:Static resources:Strings.Studio_Launch}"
                               Appearance="Primary"
                               Icon="Play24"
                               Click="OnLaunch" />
                    <ui:Button x:Name="FolderButton"
                               Content="{x:Static resources:Strings.Studio_OpenFolder}"
                               Icon="FolderOpen24"
                               Margin="8,0,0,0"
                               Click="OnOpenFolder" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:InfoBar x:Name="StatusBar"
                    Severity="Informational"
                    IsOpen="False"
                    IsClosable="True"
                    Margin="0,12,0,0" />

        <TextBlock Text="{x:Static resources:Strings.Studio_Options}" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />

        <controls:OptionControl Header="{x:Static resources:Strings.Studio_CheckUpdates}"
                                Description="{x:Static resources:Strings.Studio_CheckUpdates_Description}">
            <ui:ToggleSwitch x:Name="CheckUpdatesSwitch" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
        </controls:OptionControl>
    </StackPanel>
</ui:UiPage>
