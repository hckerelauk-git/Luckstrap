<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.FastFlagProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="FastFlagProfilesPage"
      Scrollable="False">

    <Grid Margin="0,0,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="配置方案" FontSize="20" FontWeight="Medium" />
            <TextBlock Margin="0,4,0,12"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="把整套 FastFlags 存成一份方案，换游戏或者换电脑的时候一键切回来。左边是已有的方案，右边改具体参数，改完点「保存修改」。点「应用」才会真的覆盖当前的 ClientAppSettings.json。" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <ui:Button Icon="DocumentAdd24" Content="新建空白方案" Click="OnCreateBlank" Margin="0,0,8,0" />
            <ui:Button Icon="Save24" Content="把当前配置存成方案" Click="OnSnapshotCurrent" Margin="0,0,8,0" />
            <ui:Button Icon="ArrowDownload24" Content="导入" Click="OnImport" Margin="0,0,8,0" />
            <ui:Button Icon="ArrowUpload24" Content="导出选中" Click="OnExport" Margin="0,0,8,0" />
            <ui:Button Icon="ArrowSync24" Content="刷新" Click="OnRefresh" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="ListHeader" Margin="10,8,10,4" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="方案列表" />

                    <ListBox Grid.Row="1" x:Name="ProfileList"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="OnProfileSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,5">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ui:Button Grid.Row="2" Icon="Delete24" Content="删除方案" Appearance="Danger"
                               Margin="8" HorizontalAlignment="Stretch" Click="OnDeleteProfile" />
                </Grid>
            </Border>

            <Border Grid.Column="2" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" x:Name="NameBox" Margin="0,0,8,0" PlaceholderText="方案名字" />
                        <ui:Button Grid.Column="1" Icon="Save24" Content="保存修改" Appearance="Primary" Click="OnSaveProfile" />
                    </Grid>

                    <ui:TextBox Grid.Row="1" x:Name="NoteBox" Margin="0,8,0,10" PlaceholderText="备注，随便写（可空）" />

                    <DataGrid Grid.Row="2" x:Name="FlagGrid"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" SelectionMode="Extended">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Padding" Value="8,0,8,0" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{DynamicResource TextOnAccentFillColorPrimary}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="6,0,6,0">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Flag 名" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <ui:Button Icon="Add24" Content="加一行" Click="OnAddRow" Margin="0,0,8,0" />
                            <ui:Button Icon="Delete24" Content="删掉选中行" Click="OnDeleteRows" />
                        </StackPanel>
                        <ui:Button Icon="Play24" Content="应用这套配置" Appearance="Primary"
                                   HorizontalAlignment="Right" Click="OnApply" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <ui:InfoBar x:Name="StatusBar" Grid.Row="3" Severity="Informational" IsOpen="False" IsClosable="True" Margin="0,10,0,0" />
    </Grid>
</ui:UiPage>
