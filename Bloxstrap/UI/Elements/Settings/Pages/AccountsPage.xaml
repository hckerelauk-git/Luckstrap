<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="AccountsPage"
      Scrollable="False">

    <Grid Margin="0,0,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{x:Static resources:Strings.Nav_Accounts}" FontSize="20" FontWeight="Medium" />
            <TextBlock Margin="0,4,0,12"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static resources:Strings.Accounts_Help}" />
        </StackPanel>

        <ui:InfoBar Grid.Row="1" Margin="0,0,0,10" IsOpen="True" IsClosable="False" Severity="Warning"
                    Title="{x:Static resources:Strings.Accounts_NoticeTitle}"
                    Message="{x:Static resources:Strings.Accounts_NoticeMessage}" />

        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <ui:Button Icon="PersonAdd24" Content="{x:Static resources:Strings.Accounts_SaveCurrent}" Click="OnAddCurrent" Margin="0,0,8,0" />
            <ui:Button Icon="ArrowSwap24" Content="{x:Static resources:Strings.Accounts_SwitchToSelected}" Appearance="Primary" Click="OnSwitch" Margin="0,0,8,0" />
            <ui:Button Icon="ArrowSync24" Content="{x:Static resources:Strings.Accounts_OverwriteSelected}" Click="OnOverwriteSelected" Margin="0,0,8,0" />
            <ui:Button Icon="Delete24" Content="{x:Static resources:Strings.Accounts_DeleteSelected}" Appearance="Danger" Click="OnDelete" Margin="0,0,8,0" />
            <ui:Button Icon="ArrowClockwise24" Content="{x:Static resources:Strings.Common_Refresh}" Click="OnRefresh" />
        </WrapPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <ListBox x:Name="AccountList" Margin="4" Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnAccountSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,4" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border Grid.Column="1" VerticalAlignment="Center" Padding="6,2" CornerRadius="4"
                                                Background="{DynamicResource SystemAccentColorSecondaryBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{x:Static resources:Strings.Accounts_Current}" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel Margin="10">
                    <TextBlock x:Name="ListHeader" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Accounts_Empty}" />
                    <TextBlock Margin="0,10,0,4" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Accounts_Alias}" />
                    <ui:TextBox x:Name="NameBox" PlaceholderText="{x:Static resources:Strings.Accounts_AliasPlaceholder}" />
                    <ui:Button Icon="Rename24" Content="{x:Static resources:Strings.Accounts_SaveAlias}" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnRename" />
                    <TextBlock Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{x:Static resources:Strings.Accounts_AliasHelp}" />
                </StackPanel>
            </Border>
        </Grid>

        <ui:InfoBar x:Name="StatusBar" Grid.Row="4" Severity="Informational" IsOpen="False" IsClosable="True" Margin="0,10,0,0" />
    </Grid>
</ui:UiPage>
